{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safechat.ie/schemas/safechat-mcp-manifest.v2.json",
  "title": "SafeChatMcpServerManifest",
  "description": "Declarative manifest (v1.0 or v2.0) published at GET /manifest by any SafeChat Marketplace MCP Server.",
  "type": "object",
  "required": ["schemaVersion", "serverId", "name", "vendor", "tools"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0", "2.0"]
    },
    "serverId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$",
      "description": "Unique kebab-case or reverse-DNS identifier for your MCP server (e.g. 'ie.safechat.mcp.finance' or 'acme-irish-conveyancing')."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Human-readable name of your MCP server pack."
    },
    "version": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["IE", "UK", "DE", "EU", "US", "AU"]
    },
    "isOfficial": {
      "type": "boolean"
    },
    "vendor": {
      "type": "object",
      "required": ["name", "supportEmail"],
      "properties": {
        "name": { "type": "string" },
        "supportEmail": { "type": "string", "format": "email" },
        "websiteUrl": { "type": "string", "format": "uri" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "verticals",
          "pricing",
          "requiredTokenMeta",
          "inputSchema",
          "outputFormat"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,80}$",
            "description": "Machine tool identifier invoked via JSON-RPC tools/call (e.g. 'mcp-management-accounts-commentary' or 'draft_requisitions')."
          },
          "title": {
            "type": "string",
            "description": "Display title shown on the SafeChat Marketplace card."
          },
          "description": {
            "type": "string",
            "description": "Concise explanation of what the tool does and what output it produces."
          },
          "verticals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["legal", "recruitment", "clinical", "finance", "general"]
            }
          },
          "subVertical": {
            "type": "string"
          },
          "jurisdiction": {
            "type": "string",
            "enum": ["IE", "UK", "DE", "EU", "US", "AU"]
          },
          "category": {
            "type": "string"
          },
          "tierBadge": {
            "type": "string",
            "enum": ["HERO_LAUNCH", "DEEP_AUDIT_PACK", "PARTNER_VERIFIED"]
          },
          "pricing": {
            "type": "object",
            "required": ["model", "creatorPriceEurCents"],
            "properties": {
              "model": {
                "type": "string",
                "enum": ["free", "included_in_plan", "per_call", "monthly_org", "monthly_seat"]
              },
              "creatorPriceEurCents": {
                "type": "integer",
                "minimum": 0
              },
              "trial": {
                "type": "object",
                "properties": {
                  "trialDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90
                  },
                  "trialFreeCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  }
                }
              }
            }
          },
          "requiredTokenMeta": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["entityType", "authority", "formatValid", "dateOrderIndex", "granularity"]
            }
          },
          "inputSchema": {
            "type": "object"
          },
          "outputFormat": {
            "type": "string",
            "enum": ["markdown", "json", "html", "html-preview", "docx-base64", "xlsx-base64", "csv"]
          },
          "uiSchema": {
            "type": "object"
          },
          "privacyPolicy": {
            "type": "object"
          }
        }
      }
    }
  }
}
