{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safechat.ie/schemas/safechat-mcp-manifest.v1.json",
  "title": "SafeChatMcpServerManifest",
  "description": "Declarative manifest published at GET /manifest by any SafeChat Marketplace MCP Server.",
  "type": "object",
  "required": ["schemaVersion", "serverId", "name", "vendor", "tools"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "serverId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$",
      "description": "Unique kebab-case identifier for your MCP server (e.g. 'acme-irish-conveyancing')."
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Human-readable name of your MCP server pack."
    },
    "vendor": {
      "type": "object",
      "required": ["name", "supportEmail"],
      "properties": {
        "name": { "type": "string" },
        "supportEmail": { "type": "string", "format": "email" },
        "websiteUrl": { "type": "string", "format": "uri" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "verticals",
          "pricing",
          "requiredTokenMeta",
          "inputSchema",
          "outputFormat"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_]{2,64}$",
            "description": "Machine tool identifier invoked via JSON-RPC tools/call (e.g. 'draft_requisitions')."
          },
          "title": {
            "type": "string",
            "description": "Display title shown on the SafeChat Marketplace card."
          },
          "description": {
            "type": "string",
            "description": "Concise explanation of what the tool does and what output it produces."
          },
          "verticals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["legal", "recruitment", "clinical", "finance", "general"]
            }
          },
          "pricing": {
            "type": "object",
            "required": ["model", "creatorPriceEurCents"],
            "properties": {
              "model": {
                "type": "string",
                "enum": ["free", "included_in_plan", "per_call", "monthly_org", "monthly_seat"]
              },
              "creatorPriceEurCents": {
                "type": "integer",
                "minimum": 0,
                "description": "Your net payout in EUR cents (e.g. 20 = €0.20 per call, or 4900 = €49.00/month). SafeChat adds its platform fee on top when billing the customer."
              },
              "trial": {
                "type": "object",
                "properties": {
                  "trialDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 90,
                    "description": "Optional free trial duration in days (e.g. 30)."
                  },
                  "trialFreeCalls": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Optional number of free executions per organisation before billing begins."
                  }
                }
              }
            }
          },
          "requiredTokenMeta": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["entityType", "authority", "formatValid", "dateOrderIndex", "granularity"]
            },
            "description": "Least-privilege list of non-identifying token metadata properties your tool needs."
          },
          "inputSchema": {
            "type": "object",
            "description": "Standard JSON Schema describing the fields inside arguments.input."
          },
          "outputFormat": {
            "type": "string",
            "enum": ["markdown", "json", "html-preview", "docx-base64", "csv"]
          }
        }
      }
    }
  }
}
